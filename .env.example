# =====================================================================
# Distributed Cloud Backup & Recovery Platform - Environment Config
# =====================================================================

# Server & Profile
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
POSTGRES_DB=cloud_backup_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cloud_backup_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Cloud Storage (AWS S3 / MinIO / LocalStack)
# For Local MinIO / LocalStack development:
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_BUCKET=distributed-cloud-backups
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_PATH_STYLE_ACCESS=true
AWS_REGION=us-east-1
AWS_S3_AUTO_CREATE_BUCKET=true
AWS_S3_ENABLE_VERSIONING=true

# For Real AWS S3 Production Deployment:
# AWS_S3_ENDPOINT=
# AWS_S3_BUCKET=my-production-backup-bucket
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_S3_PATH_STYLE_ACCESS=false
# AWS_REGION=us-east-1

# JWT Authentication Security (HS256 Secret 256-bit Base64)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Distributed Resilience & Retry Configuration
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_INTERVAL_MS=1000
RETRY_MULTIPLIER=2.0
